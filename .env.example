# API key riêng của bạn — hãy đổi giá trị này trước khi chạy
API_KEY=FFVN_TGM_CHANGE_THIS_TO_A_LONG_RANDOM_KEY

# Port
PORT=3000

# Giới hạn upload, đơn vị MB
MAX_UPLOAD_MB=500

# Tự xóa file sau bao nhiêu phút
FILE_TTL_MINUTES=60

# URL công khai của API khi deploy, ví dụ https://your-domain.com
PUBLIC_BASE_URL=http://localhost:3000